#:culture{:id "rus.dish.blini", :name "Blini", :country "RUS", :kind :dish, :summary "Russian pancakes, often made with a yeast-raised batter of buckwheat and/or wheat flour and milk, traditionally served with garnishes such as smetana, cottage cheese or caviar.", :url "https://en.wikipedia.org/wiki/Blini", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
